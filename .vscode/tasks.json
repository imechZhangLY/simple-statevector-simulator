{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap Python environments",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Bootstrap CUDA environment",
        "Bootstrap CPU environment"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Bootstrap CUDA environment",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/bootstrap-env.ps1",
        "-EnvironmentName",
        ".venv",
        "-Requirements",
        "requirements-torch-cuda.txt"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Bootstrap CPU environment",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/bootstrap-env.ps1",
        "-EnvironmentName",
        ".venv-cpu",
        "-Requirements",
        "requirements-torch-cpu.txt"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run benchmarks",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["benchmarks/benchmark_backends.py"],
      "problemMatcher": []
    },
    {
      "label": "Run tests (CPU torch environment)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv-cpu/Scripts/python.exe",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
